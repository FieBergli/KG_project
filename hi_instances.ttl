@prefix hi: <http://www.semanticweb.org/vbr240/ontologies/2022/4/untitled-ontology-51/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

#################################################################
# INSTANCES FOR CONTROLLED VOCABULARY SUBCLASSES
#################################################################

# Trust state instances
hi:calibratedTrustState a hi:CalibratedTrust, owl:NamedIndividual ;
    rdfs:label "calibrated trust" .

hi:underTrustState a hi:UnderTrust, owl:NamedIndividual ;
    rdfs:label "under-trust" .

hi:overTrustState a hi:OverTrust, owl:NamedIndividual ;
    rdfs:label "over-trust" .

# Autonomy level instances
hi:humanLedAutonomyLevel a hi:HumanLedAutonomy, owl:NamedIndividual ;
    rdfs:label "human-led autonomy" .

hi:aiLedAutonomyLevel a hi:AILedAutonomy, owl:NamedIndividual ;
    rdfs:label "AI-led autonomy" .

hi:dynamicAutonomyLevel a hi:DynamicAutonomy, owl:NamedIndividual ;
    rdfs:label "dynamic autonomy" .

# Explanation pattern instances
hi:progressiveDisclosurePatternInstance a hi:ProgressiveDisclosurePattern, owl:NamedIndividual ;
    rdfs:label "progressive disclosure" .

hi:interactiveExplanationPatternInstance a hi:InteractiveExplanationPattern, owl:NamedIndividual ;
    rdfs:label "interactive explanation" .

hi:counterfactualExplanationPatternInstance a hi:CounterfactualExplanationPattern, owl:NamedIndividual ;
    rdfs:label "counterfactual explanation" .

# Capability instances
hi:trustCalibrationCapability a hi:TrustCalibration, owl:NamedIndividual ;
    rdfs:label "trust calibration capability" .

hi:personalizationCapability a hi:Personalization, owl:NamedIndividual ;
    rdfs:label "personalization capability" .

hi:humanOversightCapabilityInstance a hi:HumanOversightCapability, owl:NamedIndividual ;
    rdfs:label "human oversight capability instance" .

hi:sharedDecisionMakingCapability a hi:SharedDecisionMaking, owl:NamedIndividual ;
    rdfs:label "shared decision making capability" .

hi:evidenceRetrievalCapability a hi:EvidenceRetrieval, owl:NamedIndividual ;
    rdfs:label "evidence retrieval capability" .

hi:reflectiveInteractionCapability a hi:ReflectiveInteraction, owl:NamedIndividual ;
    rdfs:label "reflective interaction capability" .

hi:scientificValidationCapability a hi:ScientificValidation, owl:NamedIndividual ;
    rdfs:label "scientific validation capability" .

hi:gazeAwarenessCapability a hi:GazeAwareness, owl:NamedIndividual ;
    rdfs:label "gaze awareness capability" .

hi:explanationSupportCapabilityInstance a hi:ExplanationSupportCapability, owl:NamedIndividual ;
    rdfs:label "explanation support capability instance" .

# Domain instances
hi:healthcareDomainInstance a hi:HealthcareDomain, owl:NamedIndividual ;
    rdfs:label "healthcare" .

hi:educationDomainInstance a hi:EducationDomain, owl:NamedIndividual ;
    rdfs:label "education" .

hi:researchDomainInstance a hi:ResearchDomain, owl:NamedIndividual ;
    rdfs:label "scientific research" .

hi:culturalHeritageDomainInstance a hi:CulturalHeritageDomain, owl:NamedIndividual ;
    rdfs:label "cultural heritage" .

hi:publicPolicyDomainInstance a hi:PublicPolicyDomain, owl:NamedIndividual ;
    rdfs:label "public policy" .

# Context instances
hi:highStakesDecisionContextInstance a hi:HighStakesDecisionContext, owl:NamedIndividual ;
    rdfs:label "high-stakes decision context" .

hi:personalizedLearningContextInstance a hi:PersonalizedLearningContext, owl:NamedIndividual ;
    rdfs:label "personalized learning context" .

hi:researchWorkflowContextInstance a hi:ResearchWorkflowContext, owl:NamedIndividual ;
    rdfs:label "research workflow context" .

hi:immersiveInteractionContextInstance a hi:ImmersiveInteractionContext, owl:NamedIndividual ;
    rdfs:label "immersive interaction context" .

hi:publicHealthPolicyContextInstance a hi:PublicHealthPolicyContext, owl:NamedIndividual ;
    rdfs:label "public health policy context" .

# Endgoal instances
hi:accurateDiagnosisGoal a hi:AccurateDiagnosis, owl:NamedIndividual ;
    rdfs:label "accurate diagnosis" .

hi:personalizedLearningImprovementGoal a hi:PersonalizedLearningImprovement, owl:NamedIndividual ;
    rdfs:label "personalized learning improvement" .

hi:robustResearchDiscoveryGoal a hi:RobustResearchDiscovery, owl:NamedIndividual ;
    rdfs:label "robust research discovery" .

# Ethical consideration instances
hi:trustEthicInstance a hi:TrustEthic, owl:NamedIndividual ;
    rdfs:label "trust" .

hi:transparencyEthicInstance a hi:TransparencyEthic, owl:NamedIndividual ;
    rdfs:label "transparency" .

hi:privacyProtectionEthicInstance a hi:PrivacyProtection, owl:NamedIndividual ;
    rdfs:label "privacy protection" .

hi:fairnessEthicInstance a hi:FairnessEthic, owl:NamedIndividual ;
    rdfs:label "fairness" .

hi:safetyEthicInstance a hi:SafetyEthic, owl:NamedIndividual ;
    rdfs:label "safety" .

hi:humanOversightEthicInstance a hi:HumanOversightEthic, owl:NamedIndividual ;
    rdfs:label "human oversight" .

# Information processing instances
hi:similaritySearchAndAnalysisProcess a hi:SimilaritySearchAndAnalysis, owl:NamedIndividual ;
    rdfs:label "similarity search and analysis" ;
    hi:informationMethod hi:Hybrid ;
    hi:processingTask hi:Reasoning , hi:Learning .

hi:adaptiveLearningAnalyticsProcess a hi:AdaptiveLearningAnalytics, owl:NamedIndividual ;
    rdfs:label "adaptive learning analytics" ;
    hi:informationMethod hi:Hybrid ;
    hi:processingTask hi:Learning , hi:Reasoning .

hi:literatureSynthesisPipelineProcess a hi:LiteratureSynthesisPipeline, owl:NamedIndividual ;
    rdfs:label "literature synthesis pipeline" ;
    hi:informationMethod hi:Neuro-symbolic ;
    hi:processingTask hi:Reasoning , hi:Generating .

hi:trustAwareDecisionSupportProcess a hi:TrustAwareDecisionSupport, owl:NamedIndividual ;
    rdfs:label "trust-aware decision support" ;
    hi:informationMethod hi:Statistical ;
    hi:processingTask hi:Reasoning .


#################################################################
# ACTORS
#################################################################

# Healthcare scenario actors
hi:Susan a hi:Patient ;
    foaf:name "Susan" ;
    hi:inScenario hi:HealthcareDiagnosisTeam .

hi:PrimaryCaregiver a hi:MedicalProfessional ;
    foaf:name "Primary caregiver" ;
    hi:capability hi:Communication , hi:Responsibility , hi:sharedDecisionMakingCapability ;
    hi:inScenario hi:HealthcareDiagnosisTeam ;
    hi:collaboratesWith hi:DiagnosisAISystem , hi:SpecialistA , hi:SpecialistB .

hi:SpecialistA a hi:MedicalProfessional ;
    foaf:name "Specialist A" ;
    hi:capability hi:Responsibility , hi:scientificValidationCapability ;
    hi:inScenario hi:HealthcareDiagnosisTeam ;
    hi:collaboratesWith hi:DiagnosisAISystem .

hi:SpecialistB a hi:MedicalProfessional ;
    foaf:name "Specialist B" ;
    hi:capability hi:Responsibility , hi:scientificValidationCapability ;
    hi:inScenario hi:HealthcareDiagnosisTeam ;
    hi:collaboratesWith hi:DiagnosisAISystem .

hi:DiagnosisAISystem a hi:DecisionSupportSystem ;
    rdfs:label "AI search and analysis system" ;
    hi:capability hi:evidenceRetrievalCapability , hi:Transparency , hi:humanOversightCapabilityInstance , hi:trustCalibrationCapability ;
    hi:processingInformation hi:similaritySearchAndAnalysisProcess , hi:trustAwareDecisionSupportProcess ;
    hi:inScenario hi:HealthcareDiagnosisTeam .

# Education scenario actors
hi:Marie a hi:RemedialTeacher ;
    foaf:name "Marie" ;
    hi:capability hi:Communication , hi:Collaborativeness ;
    hi:inScenario hi:ChildEducationTeam ;
    hi:collaboratesWith hi:John , hi:MIKE , hi:Alex .

hi:John a hi:EducationalTherapist ;
    foaf:name "John" ;
    hi:capability hi:Communication , hi:reflectiveInteractionCapability ;
    hi:inScenario hi:ChildEducationTeam ;
    hi:collaboratesWith hi:Marie , hi:MIKE , hi:Alex .

hi:Alex a hi:Human ;
    foaf:name "Alex" ;
    rdfs:comment "Alex is the child participant in the education scenario." ;
    hi:inScenario hi:ChildEducationTeam ;
    hi:collaboratesWith hi:MIKE .

hi:MIKE a hi:AssistiveRobotSystem ;
    foaf:name "MIKE" ;
    hi:capability hi:personalizationCapability , hi:gazeAwarenessCapability , hi:Adaptiveness , hi:Communication ;
    hi:processingInformation hi:adaptiveLearningAnalyticsProcess ;
    hi:inScenario hi:ChildEducationTeam .

# Research scenario actors
hi:LeadScientist a hi:ResearchScientist ;
    foaf:name "Lead scientist" ;
    hi:capability hi:scientificValidationCapability , hi:Transparency , hi:Responsibility ;
    hi:inScenario hi:ResearchHITeam ;
    hi:collaboratesWith hi:ResearchAISystem .

hi:ResearchAISystem a hi:LiteratureAnalysisSystem ;
    rdfs:label "research literature and data analysis system" ;
    hi:capability hi:evidenceRetrievalCapability , hi:explanationSupportCapabilityInstance , hi:scientificValidationCapability , hi:humanOversightCapabilityInstance ;
    hi:processingInformation hi:literatureSynthesisPipelineProcess ;
    hi:inScenario hi:ResearchHITeam .

#################################################################
# INTERACTIONS
#################################################################

hi:HealthcareInteraction a hi:Interaction ;
    hi:interactionMethod hi:Collaboration-based ;
    hi:interactionTask hi:Recommendation , hi:Question-Answering , hi:Explainability ;
    hi:interactingAgent hi:Susan , hi:PrimaryCaregiver , hi:SpecialistA , hi:SpecialistB , hi:DiagnosisAISystem .

hi:EducationInteraction a hi:Interaction ;
    hi:interactionMethod hi:Multimodal , hi:Collaboration-based ;
    hi:interactionTask hi:Recommendation , hi:Question-Answering ;
    hi:interactingAgent hi:Marie , hi:John , hi:Alex , hi:MIKE .

hi:ResearchInteraction a hi:Interaction ;
    hi:interactionMethod hi:Collaboration-based ;
    hi:interactionTask hi:Explainability , hi:Recommendation ;
    hi:interactingAgent hi:LeadScientist , hi:ResearchAISystem .

#################################################################
# THREE CHOSEN SCENARIOS
#################################################################

hi:HealthcareDiagnosisTeam a hi:HealthcareDecisionScenario ;
    rdfs:label "T3 Healthcare Diagnosis Team" ;
    hi:domain hi:healthcareDomainInstance ;
    hi:context hi:highStakesDecisionContextInstance ;
    hi:endgoal hi:accurateDiagnosisGoal ;
    hi:hasEthicalConsideration hi:trustEthicInstance , hi:transparencyEthicInstance , hi:humanOversightEthicInstance , hi:safetyEthicInstance ;
    hi:hasInteraction hi:HealthcareInteraction ;
    hi:involvesActor hi:Susan , hi:PrimaryCaregiver , hi:SpecialistA , hi:SpecialistB , hi:DiagnosisAISystem ;
    hi:hasScenarioVariant hi:HealthcareDiagnosisBestCase , hi:HealthcareDiagnosisWorstCase ;
    hi:hasAutonomyLevel hi:dynamicAutonomyLevel ;
    hi:hasTrustState hi:calibratedTrustState ;
    hi:usesExplanationPattern hi:interactiveExplanationPatternInstance ;
    hi:scenarioNote "Medical professionals collaborate with an AI search and analysis system to identify difficult diagnoses while maintaining human oversight." .

hi:HealthcareDiagnosisBestCase a hi:ScenarioVariant ;
    rdfs:label "Healthcare diagnosis best case" ;
    hi:variantOfScenario hi:HealthcareDiagnosisTeam ;
    hi:domain hi:healthcareDomainInstance ;
    hi:context hi:highStakesDecisionContextInstance ;
    hi:endgoal hi:accurateDiagnosisGoal ;
    hi:hasEthicalConsideration hi:trustEthicInstance , hi:transparencyEthicInstance , hi:humanOversightEthicInstance ;
    hi:hasInteraction hi:HealthcareInteraction ;
    hi:involvesActor hi:Susan , hi:PrimaryCaregiver , hi:SpecialistA , hi:SpecialistB , hi:DiagnosisAISystem ;
    hi:hasAutonomyLevel hi:dynamicAutonomyLevel ;
    hi:hasTrustState hi:calibratedTrustState ;
    hi:usesExplanationPattern hi:interactiveExplanationPatternInstance ;
    hi:scenarioNote "The team understands each other's expertise and the AI limitations, which leads to correct diagnosis." .

hi:HealthcareDiagnosisWorstCase a hi:ScenarioVariant ;
    rdfs:label "Healthcare diagnosis worst case" ;
    hi:variantOfScenario hi:HealthcareDiagnosisTeam ;
    hi:domain hi:healthcareDomainInstance ;
    hi:context hi:highStakesDecisionContextInstance ;
    hi:endgoal hi:accurateDiagnosisGoal ;
    hi:hasEthicalConsideration hi:trustEthicInstance , hi:safetyEthicInstance ;
    hi:hasInteraction hi:HealthcareInteraction ;
    hi:involvesActor hi:Susan , hi:PrimaryCaregiver , hi:SpecialistA , hi:SpecialistB , hi:DiagnosisAISystem ;
    hi:hasAutonomyLevel hi:aiLedAutonomyLevel ;
    hi:hasTrustState hi:overTrustState ;
    hi:usesExplanationPattern hi:interactiveExplanationPatternInstance ;
    hi:scenarioNote "Lack of knowledge sharing and poor calibration of trust in the AI lead to misdiagnosis and loss of trust." .

hi:ChildEducationTeam a hi:EducationSupportScenario ;
    rdfs:label "T2 Child Education Team" ;
    hi:domain hi:educationDomainInstance ;
    hi:context hi:personalizedLearningContextInstance ;
    hi:endgoal hi:personalizedLearningImprovementGoal ;
    hi:hasEthicalConsideration hi:trustEthicInstance , hi:fairnessEthicInstance , hi:humanOversightEthicInstance ;
    hi:hasInteraction hi:EducationInteraction ;
    hi:involvesActor hi:Marie , hi:John , hi:Alex , hi:MIKE ;
    hi:hasScenarioVariant hi:ChildEducationBestCase , hi:ChildEducationWorstCase ;
    hi:hasAutonomyLevel hi:dynamicAutonomyLevel ;
    hi:hasTrustState hi:calibratedTrustState ;
    hi:usesExplanationPattern hi:progressiveDisclosurePatternInstance ;
    hi:scenarioNote "Teacher, therapist, child, and assistive robot co-design and adapt a personalized learning program." .

hi:ChildEducationBestCase a hi:ScenarioVariant ;
    rdfs:label "Child education best case" ;
    hi:variantOfScenario hi:ChildEducationTeam ;
    hi:domain hi:educationDomainInstance ;
    hi:context hi:personalizedLearningContextInstance ;
    hi:endgoal hi:personalizedLearningImprovementGoal ;
    hi:hasEthicalConsideration hi:trustEthicInstance , hi:fairnessEthicInstance , hi:humanOversightEthicInstance ;
    hi:hasInteraction hi:EducationInteraction ;
    hi:involvesActor hi:Marie , hi:John , hi:Alex , hi:MIKE ;
    hi:hasAutonomyLevel hi:dynamicAutonomyLevel ;
    hi:hasTrustState hi:calibratedTrustState ;
    hi:usesExplanationPattern hi:progressiveDisclosurePatternInstance ;
    hi:scenarioNote "The robot provides useful feedback and the humans continuously refine the curriculum, improving Alex's confidence and performance." .

hi:ChildEducationWorstCase a hi:ScenarioVariant ;
    rdfs:label "Child education worst case" ;
    hi:variantOfScenario hi:ChildEducationTeam ;
    hi:domain hi:educationDomainInstance ;
    hi:context hi:personalizedLearningContextInstance ;
    hi:endgoal hi:personalizedLearningImprovementGoal ;
    hi:hasEthicalConsideration hi:fairnessEthicInstance ;
    hi:hasInteraction hi:EducationInteraction ;
    hi:involvesActor hi:Marie , hi:John , hi:Alex , hi:MIKE ;
    hi:hasAutonomyLevel hi:aiLedAutonomyLevel ;
    hi:hasTrustState hi:underTrustState ;
    hi:usesExplanationPattern hi:progressiveDisclosurePatternInstance ;
    hi:scenarioNote "Poor coordination or poor robot adaptation reduces learning effectiveness and child engagement." .

hi:ResearchHITeam a hi:ResearchCollaborationScenario ;
    rdfs:label "T1 Research HI Team" ;
    hi:domain hi:researchDomainInstance ;
    hi:context hi:researchWorkflowContextInstance ;
    hi:endgoal hi:robustResearchDiscoveryGoal ;
    hi:hasEthicalConsideration hi:transparencyEthicInstance , hi:trustEthicInstance , hi:humanOversightEthicInstance ;
    hi:hasInteraction hi:ResearchInteraction ;
    hi:involvesActor hi:LeadScientist , hi:ResearchAISystem ;
    hi:hasScenarioVariant hi:ResearchHIBestCase , hi:ResearchHIWorstCase ;
    hi:hasAutonomyLevel hi:dynamicAutonomyLevel ;
    hi:hasTrustState hi:calibratedTrustState ;
    hi:usesExplanationPattern hi:counterfactualExplanationPatternInstance ;
    hi:scenarioNote "A scientist and an AI system collaborate on literature analysis, data synthesis, and validation in a research pipeline." .

hi:ResearchHIBestCase a hi:ScenarioVariant ;
    rdfs:label "Research HI team best case" ;
    hi:variantOfScenario hi:ResearchHITeam ;
    hi:domain hi:researchDomainInstance ;
    hi:context hi:researchWorkflowContextInstance ;
    hi:endgoal hi:robustResearchDiscoveryGoal ;
    hi:hasEthicalConsideration hi:transparencyEthicInstance , hi:trustEthicInstance ;
    hi:hasInteraction hi:ResearchInteraction ;
    hi:involvesActor hi:LeadScientist , hi:ResearchAISystem ;
    hi:hasAutonomyLevel hi:dynamicAutonomyLevel ;
    hi:hasTrustState hi:calibratedTrustState ;
    hi:usesExplanationPattern hi:counterfactualExplanationPatternInstance ;
    hi:scenarioNote "The AI reviews methods and evidence, while the human scientists validate and contextualize the outputs." .

hi:ResearchHIWorstCase a hi:ScenarioVariant ;
    rdfs:label "Research HI team worst case" ;
    hi:variantOfScenario hi:ResearchHITeam ;
    hi:domain hi:researchDomainInstance ;
    hi:context hi:researchWorkflowContextInstance ;
    hi:endgoal hi:robustResearchDiscoveryGoal ;
    hi:hasEthicalConsideration hi:transparencyEthicInstance ;
    hi:hasInteraction hi:ResearchInteraction ;
    hi:involvesActor hi:LeadScientist , hi:ResearchAISystem ;
    hi:hasAutonomyLevel hi:aiLedAutonomyLevel ;
    hi:hasTrustState hi:overTrustState ;
    hi:usesExplanationPattern hi:counterfactualExplanationPatternInstance ;
    hi:scenarioNote "Researchers over-rely on flawed or outdated AI-generated evidence and fail to cross-check it." .

