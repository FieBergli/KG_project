hi:Paper1_TrustFactorsGame a hi:ResearchPaper, bibo:AcademicArticle ;
    hi:paperTitle "Human-AI Collaboration via Trust Factors: A Collaborative Game Use Case" ;
    hi:publicationYear "2025"^^xsd:gYear ;
    hi:doi "10.3233/FAIA250625" ;
    dcterms:identifier "10.3233/FAIA250625" ;
    dcterms:subject <https://dbpedia.org/resource/Reinforcement_learning> ,
        <https://dbpedia.org/resource/Trust_(social_sciences)> ;
    hi:relevantToScenario hi:HealthcareDiagnosisTeam , hi:ChildEducationTeam ;
    hi:hasAutonomyLevel hi:DynamicAutonomy ;
    hi:hasTrustState hi:CalibratedTrust ;
    hi:paperNote "Trust-aware task delegation and collaboration." .

