        <https://dbpedia.org/resource/Trust_(social_sciences)> ;
    hi:relevantToScenario hi:HealthcareDiagnosisTeam , hi:ChildEducationTeam ;
    hi:hasAutonomyLevel hi:dynamicAutonomyLevel ;
