@prefix hi: <http://www.semanticweb.org/vbr240/ontologies/2022/4/untitled-ontology-51/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

#################################################################
# ACTORS
#################################################################

# Healthcare scenario actors
hi:Susan a hi:Patient ;
    foaf:name "Susan" ;
    hi:inScenario hi:HealthcareDiagnosisTeam .

hi:PrimaryCaregiver a hi:MedicalProfessional ;
    foaf:name "Primary caregiver" ;
    hi:capability hi:Communication , hi:Responsibility , hi:SharedDecisionMaking ;
    hi:inScenario hi:HealthcareDiagnosisTeam ;
    hi:collaboratesWith hi:DiagnosisAISystem , hi:SpecialistA , hi:SpecialistB .

hi:SpecialistA a hi:MedicalProfessional ;
    foaf:name "Specialist A" ;
    hi:capability hi:Responsibility , hi:ScientificValidation ;
    hi:inScenario hi:HealthcareDiagnosisTeam ;
    hi:collaboratesWith hi:DiagnosisAISystem .

hi:SpecialistB a hi:MedicalProfessional ;
    foaf:name "Specialist B" ;
    hi:capability hi:Responsibility , hi:ScientificValidation ;
    hi:inScenario hi:HealthcareDiagnosisTeam ;
    hi:collaboratesWith hi:DiagnosisAISystem .

hi:DiagnosisAISystem a hi:DecisionSupportSystem ;
    rdfs:label "AI search and analysis system" ;
    hi:capability hi:EvidenceRetrieval , hi:Transparency , hi:HumanOversightCapability , hi:TrustCalibration ;
    hi:processingInformation hi:SimilaritySearchAndAnalysis , hi:TrustAwareDecisionSupport ;
    hi:inScenario hi:HealthcareDiagnosisTeam .

# Education scenario actors
hi:Marie a hi:RemedialTeacher ;
    foaf:name "Marie" ;
    hi:capability hi:Communication , hi:Collaborativeness ;
    hi:inScenario hi:ChildEducationTeam ;
    hi:collaboratesWith hi:John , hi:MIKE , hi:Alex .

hi:John a hi:EducationalTherapist ;
    foaf:name "John" ;
    hi:capability hi:Communication , hi:ReflectiveInteraction ;
    hi:inScenario hi:ChildEducationTeam ;
    hi:collaboratesWith hi:Marie , hi:MIKE , hi:Alex .

hi:Alex a hi:Human ;
    foaf:name "Alex" ;
    rdfs:comment "Alex is the child participant in the education scenario." ;
    hi:inScenario hi:ChildEducationTeam ;
    hi:collaboratesWith hi:MIKE .

hi:MIKE a hi:AssistiveRobotSystem ;
    foaf:name "MIKE" ;
    hi:capability hi:Personalization , hi:GazeAwareness , hi:Adaptiveness , hi:Communication ;
    hi:processingInformation hi:AdaptiveLearningAnalytics ;
    hi:inScenario hi:ChildEducationTeam .

# Research scenario actors
hi:LeadScientist a hi:ResearchScientist ;
    foaf:name "Lead scientist" ;
    hi:capability hi:ScientificValidation , hi:Transparency , hi:Responsibility ;
    hi:inScenario hi:ResearchHITeam ;
    hi:collaboratesWith hi:ResearchAISystem .

hi:ResearchAISystem a hi:LiteratureAnalysisSystem ;
    rdfs:label "research literature and data analysis system" ;
    hi:capability hi:EvidenceRetrieval , hi:ExplanationSupportCapability , hi:ScientificValidation , hi:HumanOversightCapability ;
    hi:processingInformation hi:LiteratureSynthesisPipeline ;
    hi:inScenario hi:ResearchHITeam .

#################################################################
# INTERACTIONS
#################################################################

hi:HealthcareInteraction a hi:Interaction ;
    hi:interactionMethod hi:Collaboration-based ;
    hi:interactionTask hi:Recommendation , hi:Question-Answering , hi:Explainability ;
    hi:interactingAgent hi:Susan , hi:PrimaryCaregiver , hi:SpecialistA , hi:SpecialistB , hi:DiagnosisAISystem .

hi:EducationInteraction a hi:Interaction ;
    hi:interactionMethod hi:Multimodal , hi:Collaboration-based ;
    hi:interactionTask hi:Recommendation , hi:Question-Answering ;
    hi:interactingAgent hi:Marie , hi:John , hi:Alex , hi:MIKE .

hi:ResearchInteraction a hi:Interaction ;
    hi:interactionMethod hi:Collaboration-based ;
    hi:interactionTask hi:Explainability , hi:Recommendation ;
    hi:interactingAgent hi:LeadScientist , hi:ResearchAISystem .

#################################################################
# THREE CHOSEN SCENARIOS
#################################################################

hi:HealthcareDiagnosisTeam a hi:HealthcareDecisionScenario ;
    rdfs:label "T3 Healthcare Diagnosis Team" ;
    hi:domain hi:HealthcareDomain ;
    hi:context hi:HighStakesDecisionContext ;
    hi:endgoal hi:AccurateDiagnosis ;
    hi:hasEthicalConsideration hi:TrustEthic , hi:TransparencyEthic , hi:HumanOversightEthic , hi:SafetyEthic ;
    hi:hasInteraction hi:HealthcareInteraction ;
    hi:involvesActor hi:Susan , hi:PrimaryCaregiver , hi:SpecialistA , hi:SpecialistB , hi:DiagnosisAISystem ;
    hi:hasScenarioVariant hi:HealthcareDiagnosisBestCase , hi:HealthcareDiagnosisWorstCase ;
    hi:hasAutonomyLevel hi:DynamicAutonomy ;
    hi:hasTrustState hi:CalibratedTrust ;
    hi:usesExplanationPattern hi:InteractiveExplanationPattern ;
    hi:scenarioNote "Medical professionals collaborate with an AI search and analysis system to identify difficult diagnoses while maintaining human oversight." .

hi:HealthcareDiagnosisBestCase a hi:ScenarioVariant ;
    rdfs:label "Healthcare diagnosis best case" ;
    hi:variantOfScenario hi:HealthcareDiagnosisTeam ;
    hi:domain hi:HealthcareDomain ;
    hi:context hi:HighStakesDecisionContext ;
    hi:endgoal hi:AccurateDiagnosis ;
    hi:hasEthicalConsideration hi:TrustEthic , hi:TransparencyEthic , hi:HumanOversightEthic ;
    hi:hasInteraction hi:HealthcareInteraction ;
    hi:involvesActor hi:Susan , hi:PrimaryCaregiver , hi:SpecialistA , hi:SpecialistB , hi:DiagnosisAISystem ;
    hi:hasAutonomyLevel hi:DynamicAutonomy ;
    hi:hasTrustState hi:CalibratedTrust ;
    hi:usesExplanationPattern hi:InteractiveExplanationPattern ;
    hi:scenarioNote "The team understands each other's expertise and the AI limitations, which leads to correct diagnosis." .

hi:HealthcareDiagnosisWorstCase a hi:ScenarioVariant ;
    rdfs:label "Healthcare diagnosis worst case" ;
    hi:variantOfScenario hi:HealthcareDiagnosisTeam ;
    hi:domain hi:HealthcareDomain ;
    hi:context hi:HighStakesDecisionContext ;
    hi:endgoal hi:AccurateDiagnosis ;
    hi:hasEthicalConsideration hi:TrustEthic , hi:SafetyEthic ;
    hi:hasInteraction hi:HealthcareInteraction ;
    hi:involvesActor hi:Susan , hi:PrimaryCaregiver , hi:SpecialistA , hi:SpecialistB , hi:DiagnosisAISystem ;
    hi:hasAutonomyLevel hi:AILedAutonomy ;
    hi:hasTrustState hi:OverTrust ;
    hi:usesExplanationPattern hi:InteractiveExplanationPattern ;
    hi:scenarioNote "Lack of knowledge sharing and poor calibration of trust in the AI lead to misdiagnosis and loss of trust." .

hi:ChildEducationTeam a hi:EducationSupportScenario ;
    rdfs:label "T2 Child Education Team" ;
    hi:domain hi:EducationDomain ;
    hi:context hi:PersonalizedLearningContext ;
    hi:endgoal hi:PersonalizedLearningImprovement ;
    hi:hasEthicalConsideration hi:TrustEthic , hi:FairnessEthic , hi:HumanOversightEthic ;
    hi:hasInteraction hi:EducationInteraction ;
    hi:involvesActor hi:Marie , hi:John , hi:Alex , hi:MIKE ;
    hi:hasScenarioVariant hi:ChildEducationBestCase , hi:ChildEducationWorstCase ;
    hi:hasAutonomyLevel hi:DynamicAutonomy ;
    hi:hasTrustState hi:CalibratedTrust ;
    hi:usesExplanationPattern hi:ProgressiveDisclosurePattern ;
    hi:scenarioNote "Teacher, therapist, child, and assistive robot co-design and adapt a personalized learning program." .

hi:ChildEducationBestCase a hi:ScenarioVariant ;
    rdfs:label "Child education best case" ;
    hi:variantOfScenario hi:ChildEducationTeam ;
    hi:domain hi:EducationDomain ;
    hi:context hi:PersonalizedLearningContext ;
    hi:endgoal hi:PersonalizedLearningImprovement ;
    hi:hasEthicalConsideration hi:TrustEthic , hi:FairnessEthic , hi:HumanOversightEthic ;
    hi:hasInteraction hi:EducationInteraction ;
    hi:involvesActor hi:Marie , hi:John , hi:Alex , hi:MIKE ;
    hi:hasAutonomyLevel hi:DynamicAutonomy ;
    hi:hasTrustState hi:CalibratedTrust ;
    hi:usesExplanationPattern hi:ProgressiveDisclosurePattern ;
    hi:scenarioNote "The robot provides useful feedback and the humans continuously refine the curriculum, improving Alex's confidence and performance." .

hi:ChildEducationWorstCase a hi:ScenarioVariant ;
    rdfs:label "Child education worst case" ;
    hi:variantOfScenario hi:ChildEducationTeam ;
    hi:domain hi:EducationDomain ;
    hi:context hi:PersonalizedLearningContext ;
    hi:endgoal hi:PersonalizedLearningImprovement ;
    hi:hasEthicalConsideration hi:FairnessEthic ;
    hi:hasInteraction hi:EducationInteraction ;
    hi:involvesActor hi:Marie , hi:John , hi:Alex , hi:MIKE ;
    hi:hasAutonomyLevel hi:AILedAutonomy ;
    hi:hasTrustState hi:UnderTrust ;
    hi:usesExplanationPattern hi:ProgressiveDisclosurePattern ;
    hi:scenarioNote "Poor coordination or poor robot adaptation reduces learning effectiveness and child engagement." .

hi:ResearchHITeam a hi:ResearchCollaborationScenario ;
    rdfs:label "T1 Research HI Team" ;
    hi:domain hi:ResearchDomain ;
    hi:context hi:ResearchWorkflowContext ;
    hi:endgoal hi:RobustResearchDiscovery ;
    hi:hasEthicalConsideration hi:TransparencyEthic , hi:TrustEthic , hi:HumanOversightEthic ;
    hi:hasInteraction hi:ResearchInteraction ;
    hi:involvesActor hi:LeadScientist , hi:ResearchAISystem ;
    hi:hasScenarioVariant hi:ResearchHIBestCase , hi:ResearchHIWorstCase ;
    hi:hasAutonomyLevel hi:DynamicAutonomy ;
    hi:hasTrustState hi:CalibratedTrust ;
    hi:usesExplanationPattern hi:CounterfactualExplanationPattern ;
    hi:scenarioNote "A scientist and an AI system collaborate on literature analysis, data synthesis, and validation in a research pipeline." .

hi:ResearchHIBestCase a hi:ScenarioVariant ;
    rdfs:label "Research HI team best case" ;
    hi:variantOfScenario hi:ResearchHITeam ;
    hi:domain hi:ResearchDomain ;
    hi:context hi:ResearchWorkflowContext ;
    hi:endgoal hi:RobustResearchDiscovery ;
    hi:hasEthicalConsideration hi:TransparencyEthic , hi:TrustEthic ;
    hi:hasInteraction hi:ResearchInteraction ;
    hi:involvesActor hi:LeadScientist , hi:ResearchAISystem ;
    hi:hasAutonomyLevel hi:DynamicAutonomy ;
    hi:hasTrustState hi:CalibratedTrust ;
    hi:usesExplanationPattern hi:CounterfactualExplanationPattern ;
    hi:scenarioNote "The AI reviews methods and evidence, while the human scientists validate and contextualize the outputs." .

hi:ResearchHIWorstCase a hi:ScenarioVariant ;
    rdfs:label "Research HI team worst case" ;
    hi:variantOfScenario hi:ResearchHITeam ;
    hi:domain hi:ResearchDomain ;
    hi:context hi:ResearchWorkflowContext ;
    hi:endgoal hi:RobustResearchDiscovery ;
    hi:hasEthicalConsideration hi:TransparencyEthic ;
    hi:hasInteraction hi:ResearchInteraction ;
    hi:involvesActor hi:LeadScientist , hi:ResearchAISystem ;
    hi:hasAutonomyLevel hi:AILedAutonomy ;
    hi:hasTrustState hi:OverTrust ;
    hi:usesExplanationPattern hi:CounterfactualExplanationPattern ;
    hi:scenarioNote "Researchers over-rely on flawed or outdated AI-generated evidence and fail to cross-check it." .

