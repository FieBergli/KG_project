@prefix ns1: <http://www.semanticweb.org/vbr240/ontologies/2022/4/untitled-ontology-51/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://anonymous> a owl:Ontology .

<http://www.semanticweb.org/vbr240/ontologies/2022/4/untitled-ontology-51> a owl:Ontology .

ns1:Adaptiveness a ns1:Capability,
        owl:NamedIndividual .

ns1:Adult a ns1:Human,
        owl:NamedIndividual .

ns1:AtttentionState a owl:Class ;
    rdfs:subClassOf ns1:UserState .

ns1:BDI a ns1:Capability,
        owl:NamedIndividual .

ns1:BiasMitigation a owl:Class ;
    rdfs:subClassOf ns1:MitigationMeasure .

ns1:Child a ns1:Human,
        owl:NamedIndividual .

ns1:Collaboration-based a ns1:InteractionMethod,
        owl:NamedIndividual .

ns1:Collaborativeness a ns1:Capability,
        owl:NamedIndividual .

ns1:Communication a ns1:Capability,
        owl:NamedIndividual .

ns1:Contribution-based a ns1:InteractionMethod,
        owl:NamedIndividual .

ns1:DecisionEvent_CollaborativeGameStrategy a ns1:DecisionEvent,
        owl:NamedIndividual ;
    ns1:hasRecommendationArtifact ns1:Recommendation_CollaborationStrategy ;
    ns1:hasUserState ns1:UserState_TrustInAITeammate ;
    ns1:interactingAgent ns1:AI_TrustGameTeammate,
        ns1:Human_User ;
    ns1:usesEvidence ns1:Evidence_GameInteractionLogs .

ns1:DecisionEvent_EnvironmentReconstruction a ns1:DecisionEvent,
        owl:NamedIndividual ;
    ns1:hasRecommendationArtifact ns1:Recommendation_ReconstructionHypothesis ;
    ns1:hasUserState ns1:UserState_ResearchCognitiveLoad ;
    ns1:interactingAgent ns1:AI_PaleoReconstructionAssistant,
        ns1:Human_Researcher ;
    ns1:usesEvidence ns1:Evidence_ArchaeologicalRecords .

ns1:DecisionEvent_GazeInteraction1 a ns1:DecisionEvent,
        owl:NamedIndividual ;
    ns1:hasRecommendationArtifact ns1:Recommendation_GazePersonalizedResponse ;
    ns1:hasUserState ns1:UserState_HighVisualAttention ;
    ns1:interactingAgent ns1:AI_GazeAwareConversationalAgent,
        ns1:Human_User ;
    ns1:usesEvidence ns1:Evidence_GazeAttentionData .

ns1:DecisionEvent_LifestyleRecommendation a ns1:DecisionEvent,
        owl:NamedIndividual ;
    ns1:hasRecommendationArtifact ns1:Recommendation_LifestyleChange ;
    ns1:hasUserState ns1:UserState_AIOverReliance ;
    ns1:interactingAgent ns1:AI_SocialHealthCoach,
        ns1:Human_User ;
    ns1:usesEvidence ns1:Evidence_LifestyleLogs .

ns1:DecisionEvent_MoralJudgement a ns1:DecisionEvent,
        owl:NamedIndividual ;
    ns1:hasRecommendationArtifact ns1:Recommendation_MoralChoice ;
    ns1:hasUserState ns1:UserState_TrustInLLM ;
    ns1:interactingAgent ns1:AI_LLM_MoralReasoner,
        ns1:Human_Expert ;
    ns1:usesEvidence ns1:Evidence_MoralDataset .

ns1:DecisionEvent_PolicySimulation a ns1:DecisionEvent,
        owl:NamedIndividual ;
    ns1:hasRecommendationArtifact ns1:Recommendation_PolicyOption ;
    ns1:interactingAgent ns1:AI_PolicySimulationAgent,
        ns1:Human_Expert ;
    ns1:usesEvidence ns1:Evidence_SimulationParameters .

ns1:DecisionEvent_TrustCalibration a ns1:DecisionEvent,
        owl:NamedIndividual ;
    ns1:hasRecommendationArtifact ns1:Recommendation_TrustAdjustment ;
    ns1:hasUserState ns1:UserState_TrustCalibrationLevel ;
    ns1:interactingAgent ns1:AI_EEG_TrustCalibrationSystem,
        ns1:Human_User ;
    ns1:usesEvidence ns1:Evidence_EEGSignalsUsed .

ns1:Designer a ns1:Human,
        owl:NamedIndividual .

ns1:EthicalScenario a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasEthicalConsideration ;
            owl:someValuesFrom ns1:EthicalConsideration ],
        ns1:Scenario .

ns1:Explainability a ns1:InteractionTask,
        owl:NamedIndividual .

ns1:FairnessRisk a owl:Class ;
    rdfs:subClassOf ns1:Risk .

ns1:FallbackStrategy a owl:Class ;
    rdfs:subClassOf ns1:MitigationMeasure .

ns1:Generating a ns1:ProcessingTask,
        owl:NamedIndividual .

ns1:HumanReview a owl:Class ;
    rdfs:subClassOf ns1:MitigationMeasure .

ns1:Human_Clinician a ns1:Human,
        owl:NamedIndividual .

ns1:Human_Learner a ns1:Human,
        owl:NamedIndividual .

ns1:Hybrid a ns1:ProcessingMethod,
        owl:NamedIndividual .

ns1:Intelligent_System a ns1:ArtificialAgent,
        owl:NamedIndividual .

ns1:Learning a ns1:ProcessingTask,
        owl:NamedIndividual .

ns1:Multimodal a ns1:InteractionMethod,
        owl:NamedIndividual .

ns1:Neuro-symbolic a ns1:ProcessingMethod,
        owl:NamedIndividual .

ns1:Non-cooperative a ns1:InteractionMethod,
        owl:NamedIndividual .

ns1:PrivacyRisk a owl:Class ;
    rdfs:subClassOf ns1:Risk .

ns1:Question-Answering a ns1:InteractionTask,
        owl:NamedIndividual .

ns1:Reasoning a ns1:ProcessingTask,
        owl:NamedIndividual .

ns1:ReliabilityRisk a owl:Class ;
    rdfs:subClassOf ns1:Risk .

ns1:Responsibility a ns1:Capability,
        owl:NamedIndividual .

ns1:Robot a ns1:ArtificialAgent,
        owl:NamedIndividual .

ns1:SafetyRisk a owl:Class ;
    rdfs:subClassOf ns1:Risk .

ns1:Single-agent a ns1:InteractionMethod,
        owl:NamedIndividual .

ns1:Statistical a ns1:ProcessingMethod,
        owl:NamedIndividual .

ns1:Symbolic a ns1:ProcessingMethod,
        owl:NamedIndividual .

ns1:Teacher a ns1:Human,
        owl:NamedIndividual .

ns1:Transforming a ns1:ProcessingTask,
        owl:NamedIndividual .

ns1:Transparency a ns1:Capability,
        owl:NamedIndividual .

ns1:TransparencyRisk a owl:Class ;
    rdfs:subClassOf ns1:Risk .

ns1:UncertaintyDisplay a owl:Class ;
    rdfs:subClassOf ns1:MitigationMeasure .

ns1:affectsTrust a owl:ObjectProperty ;
    rdfs:domain ns1:ExplanationArtifact ;
    rdfs:range ns1:UserState .

ns1:capability a owl:ObjectProperty ;
    rdfs:domain ns1:Actor ;
    rdfs:range ns1:Capability .

ns1:confidenceScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Recommendation,
        ns1:RecommendationArtifact ;
    rdfs:range xsd:decimal .

ns1:context a owl:ObjectProperty ;
    rdfs:domain ns1:Scenario ;
    rdfs:range ns1:Context .

ns1:decisionOutcome a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:DecisionEvent ;
    rdfs:range xsd:string .

ns1:domain a owl:ObjectProperty ;
    rdfs:domain ns1:Scenario ;
    rdfs:range ns1:Domain .

ns1:endgoal a owl:ObjectProperty ;
    rdfs:domain ns1:Scenario ;
    rdfs:range ns1:Endgoal .

ns1:explanationType a owl:DatatypeProperty ;
    rdfs:domain ns1:ExplanationArtifact ;
    rdfs:range xsd:string .

ns1:hasDecisionEvent a owl:ObjectProperty ;
    rdfs:domain ns1:Scenario ;
    rdfs:range ns1:DecisionEvent .

ns1:hasExplanation a owl:ObjectProperty ;
    rdfs:domain ns1:RecommendationArtifact ;
    rdfs:range ns1:ExplanationArtifact .

ns1:hasInteraction a owl:ObjectProperty ;
    rdfs:domain ns1:Scenario ;
    rdfs:range ns1:Interaction .

ns1:hasMitigation a owl:ObjectProperty ;
    rdfs:domain ns1:Scenario ;
    rdfs:range ns1:MitigationMeasure .

ns1:hasRisk a owl:ObjectProperty ;
    rdfs:domain ns1:Scenario ;
    rdfs:range ns1:Risk .

ns1:hasUserState a owl:ObjectProperty ;
    rdfs:domain ns1:DecisionEvent,
        ns1:Human ;
    rdfs:range ns1:UserState .

ns1:inScenario a owl:ObjectProperty ;
    rdfs:domain ns1:Actor ;
    rdfs:range ns1:Scenario ;
    rdfs:subPropertyOf owl:topObjectProperty .

ns1:informationMethod a owl:ObjectProperty ;
    rdfs:domain ns1:InformationProcessing ;
    rdfs:range ns1:ProcessingMethod .

ns1:interactingAgent a owl:ObjectProperty ;
    rdfs:domain ns1:Interaction ;
    rdfs:range ns1:Actor .

ns1:interactionMethod a owl:ObjectProperty ;
    rdfs:domain ns1:Interaction ;
    rdfs:range ns1:InteractionMethod .

ns1:interactionTask a owl:ObjectProperty ;
    rdfs:domain ns1:Interaction ;
    rdfs:range ns1:InteractionTask .

ns1:isBasedOnData a owl:ObjectProperty ;
    rdfs:domain ns1:EvidenceItem ;
    rdfs:range ns1:DataArtifact .

ns1:label a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ns1:processingInformation a owl:ObjectProperty ;
    rdfs:domain ns1:Actor ;
    rdfs:range ns1:InformationProcessing .

ns1:processingTask a owl:ObjectProperty ;
    rdfs:domain ns1:InformationProcessing ;
    rdfs:range ns1:ProcessingTask .

ns1:producesRecommendationArtifact a owl:ObjectProperty ;
    rdfs:domain ns1:ArtificialAgent ;
    rdfs:range ns1:RecommendationArtifact .

ns1:riskSeverity a owl:DatatypeProperty ;
    rdfs:domain ns1:Risk ;
    rdfs:range xsd:integer .

ns1:scenarioID a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns1:Scenario ;
    rdfs:range xsd:string .

ns1:scenarioTag a owl:DatatypeProperty ;
    rdfs:domain ns1:DecisionEvent ;
    rdfs:range xsd:string .

ns1:usesEvidence a owl:ObjectProperty ;
    rdfs:domain ns1:DecisionEvent ;
    rdfs:range ns1:EvidenceItem .

ns1:AI_EEG_TrustCalibrationSystem a ns1:ArtificialAgent,
        owl:NamedIndividual .

ns1:AI_GazeAwareConversationalAgent a ns1:ArtificialAgent,
        owl:NamedIndividual .

ns1:AI_LLM_MoralReasoner a ns1:ArtificialAgent,
        owl:NamedIndividual .

ns1:AI_PaleoReconstructionAssistant a ns1:ArtificialAgent,
        owl:NamedIndividual .

ns1:AI_PolicySimulationAgent a ns1:ArtificialAgent,
        owl:NamedIndividual .

ns1:AI_SocialHealthCoach a ns1:ArtificialAgent,
        owl:NamedIndividual .

ns1:AI_TrustGameTeammate a ns1:ArtificialAgent,
        owl:NamedIndividual .

ns1:AttentionState a owl:Class ;
    rdfs:subClassOf ns1:UserState .

ns1:CognitiveLoad a owl:Class ;
    rdfs:subClassOf ns1:UserState .

ns1:Data_ArchaeologyRecords a ns1:DataArtifact,
        owl:NamedIndividual ;
    ns1:label "Archaeology / environmental records"^^xsd:string .

ns1:Data_EEGSignals a ns1:DataArtifact,
        owl:NamedIndividual ;
    ns1:label "EEG signals"^^xsd:string .

ns1:Data_GazeTrackingStream a ns1:DataArtifact,
        owl:NamedIndividual ;
    ns1:label "Gaze tracking data stream"^^xsd:string .

ns1:Data_LifestyleLogs a ns1:DataArtifact,
        owl:NamedIndividual ;
    ns1:label "Lifestyle / behavior logs"^^xsd:string .

ns1:Data_MoralDilemmaSet a ns1:DataArtifact,
        owl:NamedIndividual ;
    ns1:label "Moral dilemma dataset"^^xsd:string .

ns1:Data_PolicySimulationParameters a ns1:DataArtifact,
        owl:NamedIndividual ;
    ns1:label "Policy simulation parameters"^^xsd:string .

ns1:Data_TrustGameLogs a ns1:DataArtifact,
        owl:NamedIndividual ;
    ns1:label "Game interaction logs"^^xsd:string .

ns1:Domain a owl:Class .

ns1:Endgoal a owl:Class .

ns1:Evidence_ArchaeologicalRecords a ns1:EvidenceItem,
        owl:NamedIndividual ;
    ns1:isBasedOnData ns1:Data_ArchaeologyRecords .

ns1:Evidence_EEGSignalsUsed a ns1:EvidenceItem,
        owl:NamedIndividual ;
    ns1:isBasedOnData ns1:Data_EEGSignals .

ns1:Evidence_GameInteractionLogs a ns1:EvidenceItem,
        owl:NamedIndividual ;
    ns1:isBasedOnData ns1:Data_TrustGameLogs .

ns1:Evidence_GazeAttentionData a ns1:EvidenceItem,
        owl:NamedIndividual ;
    ns1:isBasedOnData ns1:Data_GazeTrackingStream .

ns1:Evidence_LifestyleLogs a ns1:EvidenceItem,
        owl:NamedIndividual ;
    ns1:isBasedOnData ns1:Data_LifestyleLogs .

ns1:Evidence_MoralDataset a ns1:EvidenceItem,
        owl:NamedIndividual ;
    ns1:isBasedOnData ns1:Data_MoralDilemmaSet .

ns1:Evidence_SimulationParameters a ns1:EvidenceItem,
        owl:NamedIndividual ;
    ns1:isBasedOnData ns1:Data_PolicySimulationParameters .

ns1:Human_Researcher a ns1:Human,
        owl:NamedIndividual .

ns1:Justification_BehavioralAnalysis a ns1:Justification,
        owl:NamedIndividual .

ns1:Justification_DataDrivenReconstruction a ns1:Justification,
        owl:NamedIndividual .

ns1:Justification_EEGSignalAnalysis a ns1:Justification,
        owl:NamedIndividual .

ns1:Justification_GazeBasedPersonalization a ns1:Justification,
        owl:NamedIndividual .

ns1:Justification_MoralReasoning a ns1:Justification,
        owl:NamedIndividual .

ns1:Justification_SimulationResults a ns1:Justification,
        owl:NamedIndividual .

ns1:Justification_TrustFactorModel a ns1:Justification,
        owl:NamedIndividual .

ns1:ModelOutput a owl:Class ;
    rdfs:subClassOf ns1:DataArtifact .

ns1:OverReliance a owl:Class ;
    rdfs:subClassOf ns1:UserState .

ns1:Recommendation a ns1:InteractionTask,
        owl:NamedIndividual .

ns1:Recommendation_CollaborationStrategy a ns1:RecommendationArtifact,
        owl:NamedIndividual ;
    ns1:hasExplanation ns1:Justification_TrustFactorModel .

ns1:Recommendation_GazePersonalizedResponse a ns1:RecommendationArtifact,
        owl:NamedIndividual ;
    ns1:hasExplanation ns1:Justification_GazeBasedPersonalization .

ns1:Recommendation_LifestyleChange a ns1:RecommendationArtifact,
        owl:NamedIndividual ;
    ns1:hasExplanation ns1:Justification_BehavioralAnalysis .

ns1:Recommendation_MoralChoice a ns1:RecommendationArtifact,
        owl:NamedIndividual ;
    ns1:hasExplanation ns1:Justification_MoralReasoning .

ns1:Recommendation_PolicyOption a ns1:RecommendationArtifact,
        owl:NamedIndividual ;
    ns1:hasExplanation ns1:Justification_SimulationResults .

ns1:Recommendation_ReconstructionHypothesis a ns1:RecommendationArtifact,
        owl:NamedIndividual ;
    ns1:hasExplanation ns1:Justification_DataDrivenReconstruction .

ns1:Recommendation_TrustAdjustment a ns1:RecommendationArtifact,
        owl:NamedIndividual ;
    ns1:hasExplanation ns1:Justification_EEGSignalAnalysis .

ns1:UserState_AIOverReliance a ns1:OverReliance,
        owl:NamedIndividual .

ns1:UserState_HighVisualAttention a ns1:AttentionState,
        owl:NamedIndividual .

ns1:UserState_ResearchCognitiveLoad a ns1:CognitiveLoad,
        owl:NamedIndividual .

ns1:UserState_TrustCalibrationLevel a ns1:TrustLevel,
        owl:NamedIndividual .

ns1:UserState_TrustInAITeammate a ns1:TrustLevel,
        owl:NamedIndividual .

ns1:UserState_TrustInLLM a ns1:TrustLevel,
        owl:NamedIndividual .

ns1:hasEthicalConsideration a owl:ObjectProperty ;
    rdfs:domain ns1:Interaction,
        ns1:Scenario ;
    rdfs:range ns1:EthicalConsideration .

ns1:hasRecommendationArtifact a owl:ObjectProperty ;
    rdfs:domain ns1:DecisionEvent ;
    rdfs:range ns1:RecommendationArtifact .

ns1:relateToEthicalConsideration a owl:ObjectProperty ;
    rdfs:domain ns1:Risk ;
    rdfs:range ns1:EthicalConsideration .

ns1:Context a owl:Class .

ns1:Human_Expert a ns1:Human,
        owl:NamedIndividual .

ns1:InformationProcessing a owl:Class .

ns1:TrustLevel a owl:Class ;
    rdfs:subClassOf ns1:UserState .

ns1:EthicalConsideration a owl:Class .

ns1:ExplanationArtifact a owl:Class ;
    rdfs:subClassOf ns1:DataArtifact,
        owl:Thing .

ns1:Human_User a ns1:Human,
        owl:NamedIndividual .

ns1:InteractionTask a owl:Class .

ns1:MitigationMeasure a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:ProcessingMethod a owl:Class .

ns1:ProcessingTask a owl:Class .

ns1:Actor a owl:Class .

ns1:Interaction a owl:Class .

ns1:InteractionMethod a owl:Class .

ns1:Capability a owl:Class .

ns1:Justification a owl:Class ;
    rdfs:subClassOf ns1:ExplanationArtifact .

ns1:UserState a owl:Class ;
    rdfs:subClassOf ns1:Context .

ns1:Risk a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:relateToEthicalConsideration ;
            owl:someValuesFrom ns1:EthicalConsideration ],
        owl:Thing .

ns1:EvidenceItem a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:ArtificialAgent a owl:Class ;
    rdfs:subClassOf ns1:Actor .

ns1:DataArtifact a owl:Class ;
    rdfs:subClassOf owl:Thing .

ns1:Human a owl:Class ;
    rdfs:subClassOf ns1:Actor .

ns1:Scenario a owl:Class .

ns1:RecommendationArtifact a owl:Class ;
    rdfs:subClassOf ns1:ModelOutput .

ns1:DecisionEvent a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:hasRecommendationArtifact ;
            owl:someValuesFrom ns1:RecommendationArtifact ],
        ns1:Interaction .

